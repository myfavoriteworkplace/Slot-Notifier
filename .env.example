# ============================================================
# BookMySlot — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# This file is committed to git — never put real secrets here.
# For guidance on each variable, see docs/development/local-development-setup.md
# ============================================================


# ------------------------------------------------------------
# DATABASE (Required)
# ------------------------------------------------------------
# Use the Supabase DIRECT connection URL for local development (port 5432).
# Use the Supabase POOLER URL for Render production (port 6543).
# If your password has special characters, encode them: @ → %40
# Full details: docs/development/supabase-database-setup.md
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Legacy Render PostgreSQL URLs (kept for reference — no longer used)
# DATABASE_URL_RENDER=postgresql://user:password@host.oregon-postgres.render.com/dbname


# ------------------------------------------------------------
# SERVER (Required)
# ------------------------------------------------------------
NODE_ENV=production
PORT=5001
# FRONTEND_URL: set to http://localhost:5001 for simple mode, http://localhost:5173 for split mode
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001


# ------------------------------------------------------------
# SESSION (Required)
# ------------------------------------------------------------
# Generate a strong random value: openssl rand -base64 32
SESSION_SECRET=generate-a-strong-random-string-at-least-32-chars


# ------------------------------------------------------------
# ADMIN LOGIN (Required)
# ------------------------------------------------------------
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-admin-password


# ------------------------------------------------------------
# EMAIL — Resend (Optional)
# ------------------------------------------------------------
# Get API key from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Keep as onboarding@resend.dev for local testing
EMAIL_FROM=onboarding@resend.dev
# Set to PRODUCTION only when sending real emails to patients
RESEND=dev


# ------------------------------------------------------------
# IMAGE STORAGE — Cloudflare R2 (Optional)
# ------------------------------------------------------------
# If not set, image uploads are disabled but the app still works
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=app-images
R2_PUBLIC_URL=https://pub-your-id.r2.dev


# ------------------------------------------------------------
# WHATSAPP NOTIFICATIONS — Twilio (Optional)
# ------------------------------------------------------------
# If not set, WhatsApp notifications are silently disabled
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Use Twilio sandbox number for local testing: +14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886


# ------------------------------------------------------------
# SMS NOTIFICATIONS — Twilio (Optional)
# ------------------------------------------------------------
# SMS is disabled unless this is set to true.
SMS_NOTIFICATIONS_ENABLED=false
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above.
# Get this from Twilio Console → Messaging → Services.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# PAYMENTS — Razorpay (Optional)
# ------------------------------------------------------------
# Use rzp_test_ keys for local testing (no real money charged)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
