# BookMySlot - Render Backend Environment Variables
# Set these in your Render Web Service dashboard under "Environment"

# ===========================================
# DATABASE (Required)
# ===========================================
# Copy the "External Database URL" from your Render PostgreSQL service
DATABASE_URL=postgresql://user:password@host.render.com:5432/bookmyslot

# ===========================================
# SESSION (Required)
# ===========================================
# Generate a strong random string: openssl rand -base64 32
SESSION_SECRET=generate-a-strong-random-string-at-least-32-chars

# ===========================================
# ENVIRONMENT (Required)
# ===========================================
APP_ENV=production
NODE_ENV=production
PORT=10000

# ===========================================
# ADMIN AUTHENTICATION (Required)
# ===========================================
# These credentials are used to log in at /admin
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-very-secure-admin-password

# ===========================================
# EMAIL — Resend
# ===========================================
# Production and deployed Development use real configured recipients.
# Use RESEND=dev only for local development or test-recipient workflows.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=BookMySlot <onboarding@resend.dev>
RESEND=PRODUCTION

# ===========================================
# CLOUDFLARE R2 (Optional - for clinic logos)
# ===========================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ===========================================
# TWILIO SMS (Optional - disabled by default)
# ===========================================
# Set true only after the Twilio Messaging Service and sender are ready.
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
